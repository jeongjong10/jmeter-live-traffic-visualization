# Operating-system and editor metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ChatGPT project sync references; they are read-only local material, not a
# distributable part of this repository.
sources/

# Local configuration and credentials
.env
.env.*
!.env.example
# 컨테이너 기동용 환경변수는 커밋한다(비밀값 없음). 런타임 items/.env.*는 제외.
!docker/.env.*
*.pem
*.key

# Java/Maven build products
**/target/
*.class

# Node/Vite build products
**/node_modules/
**/dist/
**/.vite/
*.tsbuildinfo

# JMeter execution output and logs
*.jtl
*.log
jmeter.log
**/*.pid

# Logs (collector, E2E JMeter logs and JTL results)
logs/

# Temporary generated flow settings
tests/e2e/checkout-flow/.load-settings.*

# Test and coverage caches
.pytest_cache/
__pycache__/
coverage/
.coverage

# AI session handoff files (one-shot, not committed)
.ai/*-session-handoff.md

# btoc-like run scratch files (normally removed by run.sh)
tests/e2e/btoc-like/.btoc-like-*
