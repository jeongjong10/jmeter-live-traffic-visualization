<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree>
<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Seven-stage concurrent checkout" enabled="true"><stringProp name="TestPlan.comments">12 VU, two rounds; each request starts only after the prior HTTP response.</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp><boolProp name="TestPlan.serialize_threadgroups">false</boolProp><elementProp name="TestPlan.user_define_classpath" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp></TestPlan><hashTree>
<BackendListener guiclass="BackendListenerGui" testclass="BackendListener" testname="JMeter event collector" enabled="true"><stringProp name="classname">io.axtutorlog.jmeter.backend.EventCollectorBackendListener</stringProp><elementProp name="arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="collectorUrl" elementType="Argument"><stringProp name="Argument.name">collectorUrl</stringProp><stringProp name="Argument.value">http://127.0.0.1:8765/events</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="batchSize" elementType="Argument"><stringProp name="Argument.name">batchSize</stringProp><stringProp name="Argument.value">1</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="flushIntervalMillis" elementType="Argument"><stringProp name="Argument.name">flushIntervalMillis</stringProp><stringProp name="Argument.value">60000</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></BackendListener><hashTree/>
<ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Configurable concurrent checkout users" enabled="true"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Configurable rounds per user" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">${__P(loops,2)}</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${__P(virtualUsers,12)}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(rampUpSeconds,2)}</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp></ThreadGroup><hashTree>
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="STEP:auth|ORDER:1" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain">127.0.0.1</stringProp><stringProp name="HTTPSampler.port">18081</stringProp><stringProp name="HTTPSampler.path">/auth/login</stringProp><stringProp name="HTTPSampler.method">POST</stringProp></HTTPSamplerProxy><hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Emit auth start" enabled="true"><stringProp name="filename">${__P(journeyStartScript)}</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PreProcessor><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Record auth outcome" enabled="true"><stringProp name="filename">${__P(journeySkipScript)}</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PostProcessor><hashTree/></hashTree>
<IfController guiclass="IfControllerPanel" testclass="IfController" testname="Advance after auth" enabled="true"><stringProp name="IfController.condition">${__groovy(vars.get('step1Ok') == 'true')}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp></IfController><hashTree>
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="STEP:session|ORDER:2" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain">127.0.0.1</stringProp><stringProp name="HTTPSampler.port">18081</stringProp><stringProp name="HTTPSampler.path">/profile/session</stringProp><stringProp name="HTTPSampler.method">GET</stringProp></HTTPSamplerProxy><hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Emit session start" enabled="true"><stringProp name="filename">${__P(journeyStartScript)}</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PreProcessor><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Record session outcome" enabled="true"><stringProp name="filename">${__P(journeySkipScript)}</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PostProcessor><hashTree/></hashTree>
<IfController guiclass="IfControllerPanel" testclass="IfController" testname="Advance after session" enabled="true"><stringProp name="IfController.condition">${__groovy(vars.get('step2Ok') == 'true')}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp></IfController><hashTree>
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="STEP:search|ORDER:3" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain">127.0.0.1</stringProp><stringProp name="HTTPSampler.port">18081</stringProp><stringProp name="HTTPSampler.path">/catalog/search</stringProp><stringProp name="HTTPSampler.method">GET</stringProp></HTTPSamplerProxy><hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Emit search start" enabled="true"><stringProp name="filename">${__P(journeyStartScript)}</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PreProcessor><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Record search outcome" enabled="true"><stringProp name="filename">${__P(journeySkipScript)}</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PostProcessor><hashTree/></hashTree>
<IfController guiclass="IfControllerPanel" testclass="IfController" testname="Advance after search" enabled="true"><stringProp name="IfController.condition">${__groovy(vars.get('step3Ok') == 'true')}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp></IfController><hashTree>
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="STEP:product-detail|ORDER:4" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain">127.0.0.1</stringProp><stringProp name="HTTPSampler.port">18081</stringProp><stringProp name="HTTPSampler.path">/catalog/products/sku-espresso</stringProp><stringProp name="HTTPSampler.method">GET</stringProp></HTTPSamplerProxy><hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Emit detail start" enabled="true"><stringProp name="filename">${__P(journeyStartScript)}</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PreProcessor><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Record detail outcome" enabled="true"><stringProp name="filename">${__P(journeySkipScript)}</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PostProcessor><hashTree/></hashTree>
